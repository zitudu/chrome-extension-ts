{
  "manifest_version": 3,
  "name": "chrome-extension-ts",
  "version": "1.0.0",
  "description": "Chrome extension ts.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "tags"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "permissions": [
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
