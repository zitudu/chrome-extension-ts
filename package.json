    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "build:popup": "webpack --config webpack.popup.config.js --mode production",
    "build:background": "tsc src/background/index.ts --outDir dist --target ES2020 --module ESNext",
