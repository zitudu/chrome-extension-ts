    "build:options": "webpack --config webpack.options.config.js --mode production",
    "build:all": "npm run build && npm run build:background && npm run build:content && npm run build:options",
    "start": "npm run dev",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
